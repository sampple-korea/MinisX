<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget card, light mode: frosted white that lets the wallpaper show through.
     The dark twin is in drawable-night. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#CCFFFFFF"
        android:endColor="#B3FFFFFF" />
    <stroke android:width="1dp" android:color="#80FFFFFF" />
    <corners android:radius="28dp" />
</shape>
