<?xml version="1.0" encoding="utf-8"?>
<!-- MinisX ships only English (values/) and Korean (values-ko/). Every extra language is one more
     set of strings to keep in step on each change, so the rest were dropped. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en"/>
    <locale android:name="ko"/>
</locale-config>
